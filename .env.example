# Client ID é público; NUNCA use client secret no Vite/GitHub Pages.
# Cadastre exatamente a URL do site como Redirect URI no painel Spotify.
VITE_SPOTIFY_CLIENT_ID=
VITE_ENABLE_SPOTIFY=true
# Supabase Project URL and anon/publishable key; both are safe for browser use with RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_DISCOVERY=true
VITE_ENABLE_POPULARITY=true
VITE_ENABLE_REQUESTS=true
# qr = o cliente mostra um QR e o garçom cria o pedido (padrão); remoto = o cliente pede sozinho.
VITE_REQUEST_MODE=qr
# G-XXXX = Google Analytics 4 (com eventos); outro valor = token do Cloudflare Web Analytics. Vazio = desligado.
VITE_ANALYTICS_ID=
# Endereço público usado no QR do cartaz (cartaz.html), ex.: https://bardacassia.com.br/. Vazio = endereço atual.
VITE_SITE_URL=
# Login (Supabase Auth). Uses the same URL/anon key above.
VITE_ENABLE_AUTH=true
# OAuth buttons to show, comma-separated (google,facebook). Enable each provider in Supabase first.
VITE_AUTH_PROVIDERS=
# Cloudflare Turnstile site key (public). The secret key goes only in Supabase Auth > Attack Protection.
VITE_AUTH_CAPTCHA_SITE_KEY=
# Deezer proxy Edge Function, e.g. https://<project>.supabase.co/functions/v1/deezer-proxy. Empty = JSONP fallback.
VITE_DEEZER_PROXY_URL=
# Service-role key is only for the catalog-sync script and GitHub Actions secret. Never use VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

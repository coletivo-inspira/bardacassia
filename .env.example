# Client ID é público; NUNCA use client secret no Vite/GitHub Pages.
# Cadastre exatamente a URL do site como Redirect URI no painel Spotify.
VITE_SPOTIFY_CLIENT_ID=
VITE_ENABLE_SPOTIFY=true
# Supabase Project URL and anon/publishable key; both are safe for browser use with RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_DISCOVERY=true
VITE_ENABLE_POPULARITY=true
# Service-role key is only for the catalog-sync script and GitHub Actions secret. Never use VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
